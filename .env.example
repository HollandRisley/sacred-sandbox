# The local maths assistant. Copy to .env.local and edit.
# This file is read by the DEV SERVER ONLY — none of it reaches the browser,
# and none of it exists in a production build.

# Anything speaking the OpenAI chat-completions shape: Ollama, LM Studio,
# llama.cpp's server, vLLM. This is the default if unset.
AI_ENDPOINT=http://localhost:11434/v1/chat/completions
AI_MODEL=qwen2.5-coder:14b

# Optional. Most local servers need no key.
# AI_KEY=

# Or use your own Anthropic key instead of a local model.
# Needs the SDK: npm i -D @anthropic-ai/sdk
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5
# AI_KEY=sk-ant-...
